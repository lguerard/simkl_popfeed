# Popfeed <-> Simkl bidirectional sync configuration

# Simkl API application client ID (from https://simkl.com/settings/developer/)
SIMKL_CLIENT_ID=your_simkl_client_id_here

# Long-lived (~5 year) access token obtained by running:
#   simkl-popfeed --setup
SIMKL_ACCESS_TOKEN=your_simkl_access_token_here

# Popfeed / Bluesky account credentials (the same account jellyfin_popfeed
# already writes to)
POPFEED_IDENTIFIER=yourhandle.bsky.social
POPFEED_PASSWORD=your_app_password_here

# Optional: PDS URL (default: https://eurosky.social)
# POPFEED_PDS_URL=https://eurosky.social

# Optional: override the Watched Movies/Shows/Recent list names if your
# jellyfin_popfeed setup uses custom names instead of the defaults
# ("Watched Movies", "Watched Shows", "Recent"). Leaving these unset reuses
# whatever jellyfin_popfeed already created.
# SIMKL_POPFEED_WATCHED_MOVIES_LIST_NAME=Watched Movies
# SIMKL_POPFEED_WATCHED_SHOWS_LIST_NAME=Watched Shows
# SIMKL_POPFEED_RECENT_LIST_NAME=Recent

# Set to "true" to log actions without writing to Popfeed
# DRY_RUN=false

# Optional: a free TMDb API key (https://www.themoviedb.org/settings/api).
# When set, seasons get marked complete on Popfeed once every episode is
# watched, and series once every season is -- this needs TMDb since
# neither Simkl nor Popfeed expose total episode counts, only what's been
# watched. Leaving this unset skips that step entirely; everything else
# still works.
# TMDB_API_KEY=your_tmdb_api_key_here

# --- Optional: additional people/profiles ---------------------------------
# Everything above is profile 1. To sync more than one person's Simkl +
# Popfeed accounts in the same run (e.g. everyone on a shared Jellyfin
# server, each with their own accounts), add a "_2", "_3", ... suffix for
# each additional person. SIMKL_CLIENT_ID and TMDB_API_KEY above are shared
# by every profile -- one Simkl app registration and one TMDb key cover any
# number of people. See README.md "Multiple people" for details.
#
# SIMKL_ACCESS_TOKEN_2=second_persons_simkl_access_token
# POPFEED_IDENTIFIER_2=secondperson.bsky.social
# POPFEED_PASSWORD_2=second_persons_app_password
# POPFEED_PDS_URL_2=https://eurosky.social
# SIMKL_POPFEED_WATCHED_MOVIES_LIST_NAME_2=Watched Movies
# SIMKL_POPFEED_WATCHED_SHOWS_LIST_NAME_2=Watched Shows
# SIMKL_POPFEED_RECENT_LIST_NAME_2=Recent
